{
  "name": "reading-log",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "esbuild src/client.ts --bundle --minify --format=esm --outfile=public/add.js",
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none --test-reporter=spec test/*.test.ts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate": "wrangler d1 migrations apply AUTH_DB --remote"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "entities": "^8.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.0-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  }
}
